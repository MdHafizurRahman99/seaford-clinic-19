<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="employee_weekly_availability_own_rule" model="ir.rule">
            <field name="name">employee weekly availability: own</field>
            <field name="model_id" ref="model_hr_employee_weekly_availability"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[
                ('employee_id.user_id', '=', user.id)
            ]</field>
        </record>

        <record id="employee_weekly_availability_hr_rule" model="ir.rule">
            <field name="name">employee weekly availability: hr</field>
            <field name="model_id" ref="model_hr_employee_weekly_availability"/>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
