<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="page_test_page" model="website.page">
    <field name="name">Test Page</field>
    <field name="is_published" eval="True"/>
    <field name="key">theme_medical_clinic_east.page_test_page</field>
    <field name="url">/test-page</field>
    <field name="type">qweb</field>
    <field name="arch" type="xml">
        <t t-name="theme_medical_clinic_east.page_test_page">
            <t t-call="website.layout">
                <t t-set="additional_title">Test Page</t>
                <div id="wrap" class="oe_structure">

                    <section class="pt80 pb64" data-snippet="s_text_block"
                             style="background: linear-gradient(135deg, rgba(26,74,84,0.96) 0%, rgba(56,153,172,0.82) 100%);">
                        <div class="container text-center">
                            <p class="text-uppercase small fw-bold mb-2" style="color: rgba(255,255,255,0.78); letter-spacing: 2px;">Demo Form</p>
                            <h1 style="color: #ffffff; font-weight: 800; font-size: 2.8rem;">Test Page</h1>
                            <p style="color: rgba(255,255,255,0.88); font-size: 1.08rem; max-width: 720px; margin: 0 auto;">
                                This sample page shows a website form inside your Seaford East Medical Clinic theme, including an Odoo-powered signature field for typed or drawn signatures.
                            </p>
                        </div>
                    </section>

                    <section id="test-page-form" class="pt64 pb80" data-snippet="s_text_block">
                        <div class="container">
                            <div class="row justify-content-center">
                                <div class="col-xl-9 col-lg-10">
                                    <div class="rounded-4 p-4 p-lg-5"
                                         style="background: linear-gradient(180deg, #f8fcfc 0%, #ffffff 100%); border: 1px solid rgba(56,153,172,0.16); box-shadow: 0 18px 48px rgba(26,74,84,0.10);">
                                        <div class="row g-5 align-items-start">
                                            <div class="col-lg-5">
                                                <p class="text-uppercase small fw-bold mb-2" style="color: #3899ac; letter-spacing: 2px;">Form Preview</p>
                                                <h2 style="font-weight: 800; color: #1a4a54;">Collect signed website submissions</h2>
                                                <p style="color: #5b6a6e; line-height: 1.85; margin-bottom: 0;">
                                                    Visitors can complete their details, add a typed or drawn signature through Odoo&apos;s built-in signing interface, and submit the finished form from this page.
                                                </p>
                                            </div>
                                            <div class="col-lg-7">
                                                <t t-if="request.params.get('submitted')">
                                                    <div class="alert alert-success border-0 rounded-4 mb-4" style="background: #eaf9f2; color: #217f59;">
                                                        Your form has been submitted successfully.
                                                    </div>
                                                </t>
                                                <t t-if="request.params.get('error')">
                                                    <div class="alert alert-danger border-0 rounded-4 mb-4" style="background: #fff1f1; color: #b54747;">
                                                        Please complete all required fields, including the signature, before submitting.
                                                    </div>
                                                </t>
                                                <form action="/test-page/submit" method="post">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <div class="row g-3">
                                                        <div class="col-12">
                                                            <label for="test_page_full_name" class="form-label" style="font-weight: 700; color: #1a4a54;">Full Name</label>
                                                            <input id="test_page_full_name" type="text" name="name" class="form-control" required="required" autocomplete="name"
                                                                   style="border-radius: 14px; border: 1px solid rgba(26,74,84,0.15); padding: 0.85rem 1rem;"/>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label for="test_page_email" class="form-label" style="font-weight: 700; color: #1a4a54;">Email Address</label>
                                                            <input id="test_page_email" type="email" name="email" class="form-control" required="required" autocomplete="email"
                                                                   style="border-radius: 14px; border: 1px solid rgba(26,74,84,0.15); padding: 0.85rem 1rem;"/>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label for="test_page_phone" class="form-label" style="font-weight: 700; color: #1a4a54;">Phone Number</label>
                                                            <input id="test_page_phone" type="tel" name="phone" class="form-control" autocomplete="tel"
                                                                   style="border-radius: 14px; border: 1px solid rgba(26,74,84,0.15); padding: 0.85rem 1rem;"/>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label" style="font-weight: 700; color: #1a4a54;">Signature</label>
                                                            <div class="o_test_page_signature_mount"
                                                                 data-full-name-input-id="test_page_full_name"/>
                                                        </div>
                                                        <div class="col-12 d-flex flex-wrap justify-content-end">
                                                            <button type="submit" class="btn"
                                                                    style="background: linear-gradient(135deg, #3899ac, #1a4a54); color: #ffffff; font-weight: 700; padding: 0.9rem 2.2rem; border-radius: 14px 0 14px 0;">
                                                                Submit
                                                            </button>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                </div>
            </t>
        </t>
    </field>
</record>

</odoo>
