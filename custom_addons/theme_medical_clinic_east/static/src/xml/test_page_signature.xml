<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="theme_medical_clinic_east.TestPageSignatureField">
        <div t-ref="root" class="o_test_page_signature_field">
            <input type="hidden" name="signature" t-att-value="state.signatureImage"/>
            <input type="hidden" name="signature_name" t-att-value="state.signatureName"/>

            <div class="rounded-4 p-4" style="border: 1px solid rgba(26,74,84,0.15); background: #ffffff;">
                <div class="d-flex flex-wrap align-items-center justify-content-between" style="gap: 12px;">
                    <div>
                        <p style="margin: 0; font-weight: 700; color: #1a4a54;">Use Odoo Signature</p>
                        <p style="margin: 0.35rem 0 0; color: #6c7d80; font-size: 0.92rem;">
                            Choose Auto to type your signature or Draw to sign by hand.
                        </p>
                    </div>
                    <div class="d-flex flex-wrap" style="gap: 10px;">
                        <button type="button" class="btn btn-outline-secondary" t-on-click="openSignatureDialog"
                                style="border-radius: 12px; font-weight: 600;">
                            <t t-if="state.signatureImage">Update Signature</t>
                            <t t-else="">Create Signature</t>
                        </button>
                        <button t-if="state.signatureImage" type="button" class="btn btn-link"
                                t-on-click="clearSignature"
                                style="color: #b54747; text-decoration: none; font-weight: 600;">
                            Clear
                        </button>
                    </div>
                </div>

                <div class="rounded-4 mt-3 d-flex align-items-center justify-content-center"
                     style="min-height: 180px; border: 1px dashed rgba(56,153,172,0.35); background: linear-gradient(180deg, #fbfefe 0%, #f3fbfc 100%);">
                    <t t-if="state.signatureImage">
                        <img t-att-src="state.signatureImage"
                             alt="Signature preview"
                             class="img-fluid"
                             style="max-height: 140px; object-fit: contain;"/>
                    </t>
                    <t t-else="">
                        <div class="text-center px-3">
                            <i class="fa fa-pencil-square-o d-block mb-2" style="font-size: 1.9rem; color: #3899ac;"/>
                            <p style="margin: 0; color: #5b6a6e;">
                                No signature added yet.
                            </p>
                        </div>
                    </t>
                </div>

                <div t-if="state.error" class="alert alert-danger border-0 rounded-4 mt-3 mb-0"
                     style="background: #fff1f1; color: #b54747;">
                    <t t-esc="state.error"/>
                </div>
            </div>
        </div>
    </t>

</templates>
