<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_medical_clinic_contact_request_list" model="ir.ui.view">
        <field name="name">medical.clinic.contact.request.list</field>
        <field name="model">medical.clinic.contact.request</field>
        <field name="arch" type="xml">
            <list string="Contact Requests" default_order="submitted_on desc">
                <field name="submitted_on"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="subject"/>
                <field name="status"/>
                <field name="website_id"/>
            </list>
        </field>
    </record>

    <record id="view_medical_clinic_contact_request_form" model="ir.ui.view">
        <field name="name">medical.clinic.contact.request.form</field>
        <field name="model">medical.clinic.contact.request</field>
        <field name="arch" type="xml">
            <form string="Contact Request">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="subject"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="submitted_on" readonly="1"/>
                            <field name="website_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_medical_clinic_contact_requests" model="ir.actions.act_window">
        <field name="name">Contact Requests</field>
        <field name="res_model">medical.clinic.contact.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_medical_clinic_contact_requests"
        name="Contact Requests"
        parent="website.menu_website_global_configuration"
        action="action_medical_clinic_contact_requests"
        groups="website.group_website_designer,base.group_system"
        sequence="86"/>

</odoo>
